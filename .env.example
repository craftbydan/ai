# Copy to .env (API) and apps/web/.env.local (web). Never commit real values.

# --- General (Prompt 1) ---
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ENV=dev                 # dev only: enables DEV_USER, BILLING=off, CLASSIFIER/AGENT mocks, GET /admin/cost
DEV_USER=0              # 1 (ENV=dev only): act as the seeded dev user when nobody is logged in
DATA_DIR=./data
RENDERER=fake            # fake | onedm
OCR=fake                 # fake | trocr
SECRET_KEY=<GENERATE_A_RANDOM_32_BYTE_STRING>   # signs session cookies. Unset is allowed only in ENV=dev (insecure random per-process key, with a warning)

# --- Agent (Prompt 8) ---
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>      # needed for live agent runs only; tests use a mock
AGENT_MODEL=claude-haiku-5-5

# --- Safety (Prompt 9) ---
CLASSIFIER=real          # real | mock:<kind>  (kind: ok|cheque|contract|legal|government_form|school_assignment|exam); test switch, ignored when ENV=production

# --- One-DM GPU worker (Prompt 4) ---
ONEDM_REPO_DIR=./vendor/One-DM
ONEDM_WEIGHTS_PATH=<PATH_TO_ONE_DM_ENGLISH_CHECKPOINT>
ONEDM_VAE_PATH=runwayml/stable-diffusion-v1-5   # HF id or local dir containing vae/ (One-DM loads the SD 1.5 VAE)
GPU_COST_THB_PER_HOUR=<YOUR_GPU_RENTAL_PRICE_IN_THB_PER_HOUR>

# --- Billing, TEST MODE ONLY (Prompt 11) ---
STRIPE_SECRET_KEY=<YOUR_STRIPE_TEST_SECRET_KEY>          # must start with sk_test_
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_TEST_WEBHOOK_SECRET>  # whsec_...
BILLING=on               # on | off. off skips payment and is honoured ONLY when ENV=dev (use off for local work without Stripe)
PRICING_MODE=per_document   # per_document | per_page
PRICE_THB_PER_DOCUMENT=20
PRICE_THB_PER_PAGE=1
MAX_PAGES_PER_DOCUMENT=10

# --- Web app and e2e test switches (Prompt 10) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # apps/web/.env.local
AGENT=real               # real | mock  (mock: fixed centred placement, no API key; ignored when ENV=production)
# CLASSIFIER=mock:<kind> also honours the X-Test-Classifier request header (same ignore-in-production rule).
