# Copy to .env (API) and apps/web/.env.local (web). Never commit real values.

# --- General (Prompt 1) ---
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
DATA_DIR=./data
RENDERER=fake            # fake | onedm
OCR=fake                 # fake | trocr
SECRET_KEY=<GENERATE_A_RANDOM_32_BYTE_STRING>   # Prompt 11 (sessions)

# --- Agent (Prompt 8) ---
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>      # needed for live agent runs only; tests use a mock
AGENT_MODEL=claude-haiku-5-5

# --- One-DM GPU worker (Prompt 4) ---
ONEDM_REPO_DIR=./vendor/One-DM
ONEDM_WEIGHTS_PATH=<PATH_TO_ONE_DM_ENGLISH_CHECKPOINT>
GPU_COST_THB_PER_HOUR=<YOUR_GPU_RENTAL_PRICE_IN_THB_PER_HOUR>

# --- Billing, TEST MODE ONLY (Prompt 11) ---
STRIPE_SECRET_KEY=<YOUR_STRIPE_TEST_SECRET_KEY>          # must start with sk_test_
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_TEST_WEBHOOK_SECRET>  # whsec_...
PRICE_THB_PER_DOCUMENT=20
MAX_PAGES_PER_DOCUMENT=10
